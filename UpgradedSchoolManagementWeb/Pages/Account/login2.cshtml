@page
@model UpgradedSchoolManagementWeb.Pages.Account.login2Model
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Username Login | D-BEST RETURN TECH</title>
    <!-- Bootstrap 5 + Icons bundle (minimal) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 (free) for a clean user icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
            /* soft background gradient – modern and calm */
            body {
                background: linear-gradient(145deg, #f8faff 0%, #e9f0f9 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
                padding: 1.5rem;
                font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            }

            .login-card {
                background: rgba(255,255,255,0.75);
                backdrop-filter: blur(6px);
                -webkit-backdrop-filter: blur(6px);
                border: 1px solid rgba(255,255,255,0.5);
                border-radius: 2.5rem;
                box-shadow: 0 25px 50px -10px rgba(0,20,40,0.25);
                padding: 2.5rem 2rem;
                max-width: 440px;
                width: 100%;
                transition: transform 0.2s ease;
            }

                .login-card:hover {
                    transform: translateY(-4px);
                }

            .login-icon {
                font-size: 3.2rem;
                color: #0d6efd;
                background: white;
                width: 80px;
                height: 80px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                margin: 0 auto 1.2rem;
                box-shadow: 0 8px 18px rgba(13, 110, 253, 0.15);
                border: 1px solid rgba(13, 110, 253, 0.1);
            }

            .form-floating > .form-control {
                border-radius: 40px;
                padding: 1.2rem 1.2rem 0.8rem 1.2rem;
                background: rgba(255,255,255,0.7);
                border: 1px solid #dce3ed;
                transition: all 0.15s ease;
            }

                .form-floating > .form-control:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.15);
                    background: white;
                }

            .form-floating > label {
                padding-left: 1.2rem;
                color: #5a6a7e;
                font-weight: 450;
                letter-spacing: -0.01em;
            }

            .form-floating > .form-control:focus ~ label {
                color: #0d6efd;
            }

            .btn-primary {
                border-radius: 40px;
                padding: 0.8rem 1.8rem;
                font-weight: 600;
                letter-spacing: 0.3px;
                background: #0d6efd;
                border: none;
                box-shadow: 0 8px 18px rgba(13, 110, 253, 0.25);
                transition: all 0.2s ease;
                width: 100%;
            }

                .btn-primary:hover {
                    background: #0b5ed7;
                    transform: scale(1.01);
                    box-shadow: 0 12px 24px rgba(13, 110, 253, 0.35);
                }

                .btn-primary:active {
                    transform: scale(0.98);
                }

            .login-footer {
                color: #5e6f88;
                font-size: 0.9rem;
                margin-top: 1.5rem;
                border-top: 1px solid rgba(0,0,0,0.04);
                padding-top: 1.5rem;
                text-align: center;
            }

                .login-footer a {
                    color: #0d6efd;
                    text-decoration: none;
                    font-weight: 500;
                }

                    .login-footer a:hover {
                        text-decoration: underline;
                    }

            .input-group-append-icon {
                position: relative;
            }
            /* small tweak for floating label inside group */
            .form-floating {
                margin-bottom: 0.2rem;
            }

            .username-hint {
                font-size: 0.85rem;
                color: #5e6f88;
                margin-top: 0.5rem;
                margin-left: 0.5rem;
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .username-hint i {
                    color: #0d6efd;
                    font-size: 0.7rem;
                    opacity: 0.7;
                }
            /* no password field – clean & minimal */
            .no-password-badge {
                display: inline-block;
                background: rgba(13, 110, 253, 0.08);
                color: #0d6efd;
                padding: 0.25rem 1rem;
                border-radius: 30px;
                font-size: 0.8rem;
                font-weight: 500;
                letter-spacing: 0.2px;
                margin-bottom: 1.25rem;
                border: 1px solid rgba(13, 110, 253, 0.1);
            }
            @@media (max-width: 480px) {
                .login-card {
                    padding: 2rem 1.5rem;
                    border-radius: 2rem;
                }
            }
    </style>
</head>
<body>
    <div class="login-card">
        <!-- icon + heading -->
        <div class="text-center">
            <div class="login-icon">
                <i class="fas fa-user-astronaut"></i>
            </div>
            <h3 class="fw-bold mb-1" style="color: #1b2a41;">Welcome</h3>
            <p class="text-secondary mb-3" style="font-size: 0.95rem;">sign in with your username</p>
            <div class="no-password-badge">
                <i class="fas fa-key me-1" style="opacity:0.7;"></i> username only
            </div>
        </div>

        <!-- login form – only username field -->
        <form method="post">
            <div class="form-floating mb-3">
                <input type="text" class="form-control" asp-for="username" placeholder="Username"
                       autofocus required aria-label="Username">
                <label for="Username">
                    <i class="fas fa-user me-2" style="color:#6c7a8d;"></i>Username
                </label>
            </div>
            <span asp-validation-for="username" class="text-danger small"></span>
            <!-- subtle hint (optional but adds polish) -->
            <div class="username-hint">
                <i class="fas fa-circle-check"></i>
                <span>Enter any username </span>
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <!-- submit button -->
            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-right-to-bracket me-2"></i>Sign in
                </button>
            </div>

            <!-- extra footer (demo / reset) -->
            <div class="login-footer">
                <span class="mx-1">·</span>
                <a href="#" onclick="document.getElementById('Username').value=''; document.getElementById('Username').focus(); return false;">
                    <i class="fas fa-undo-alt me-1"></i>clear
                </a>
            </div>
        </form>
    </div>

    <!--Add Jquery and other scripts -->
    <script src="/lib/jquery/jquery.min.js"></script>
    <!-- Bootstrap JS bundle (for potential toggles, but we use minimal) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js">
    </script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>